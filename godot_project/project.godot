; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="MMORPG Nakama Client"
config/description="Godot 4 client for MMORPG-grade Nakama server integration (2D top-down)"
run/main_scene="res://scenes/auth/LoginScreen.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Nakama="*res://addons/com.heroiclabs.nakama/Nakama.gd"
NakamaManager="*res://autoload/NakamaManager.gd"
WorldState="*res://autoload/WorldState.gd"
UIManager="*res://autoload/UIManager.gd"
AbilityTargeting="*res://autoload/AbilityTargeting.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/stretch/mode="canvas_items"

